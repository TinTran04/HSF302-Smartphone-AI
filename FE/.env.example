VITE_API_BASE_URL=/api
VITE_API_TARGET=http://localhost:8080
# The real API is the default. Set true to run the interface demo.
# VITE_* values are public frontend configuration.
VITE_ENABLE_MOCK_API=false
# Optional map tiles and matching provider attribution. Defaults use OpenStreetMap.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
