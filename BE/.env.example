# Copy this file to BE/.env and fill the values, or receive BE/.env privately.
# Use KEY=value without surrounding quotes. Escape a literal backslash as \\.
# BE/.env is ignored by Git. Restart BE after editing this file.

# PostgreSQL must already contain the smartphone_ai database and pgvector.
DB_URL=jdbc:postgresql://localhost:5432/smartphone_ai
DB_USERNAME=postgres
DB_PASSWORD=

# Gmail sender and Google App Password for OTP and account invitations.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_LOCALHOST=localhost

# Creates the root Admin, or assigns email to a legacy root without email.
ROOT_ADMIN_EMAIL=admin@example.com
ROOT_ADMIN_PASSWORD=

# Base64 encoding of 32 random bytes. Keep the same key for this database.
# Chat and embedding provider API keys are managed in the Admin interface.
AI_CONFIG_ENCRYPTION_KEY=
